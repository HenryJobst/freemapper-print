# LF everywhere: golden files and embedded symbol sets must be byte-identical on all platforms.
* text=auto eol=lf
*.png binary
*.jpg binary
*.zip binary
*.tif binary
*.pdf binary
*.ttf binary
# Purple Pen fixtures stay byte-identical to the originals (CRLF, BOM); see their README.
*.ppen -text
# Purple Pen's description symbols stay byte-identical to the original (CRLF, BOM); see data/README.md.
crates/freemapper-print/data/purple-pen-symbols.xml -text
